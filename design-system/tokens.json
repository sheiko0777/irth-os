{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "IRTH OS Design System",
  "version": "2.1.0",
  "description": "Arabic-first RTL operations design tokens for IRTH OS. Inspired by proven system patterns without copying any external system.",
  "primitive": {
    "color": {
      "void": "#020406",
      "ink": "#060A10",
      "surface": "#0E1622",
      "card": "#131E2E",
      "raised": "#182436",
      "rim1": "#1A2840",
      "rim2": "#223050",
      "rim3": "#2C3E66",
      "t1": "#F0F6FF",
      "t2": "#93B0D0",
      "t3": "#6D90B0",
      "t4": "#263A52",
      "gold": "#E09000",
      "gold2": "#F5A800",
      "gold3": "#FFC340",
      "emerald": "#00C478",
      "crimson": "#E83838",
      "azure": "#2E8FFF",
      "amber": "#F5A500"
    },
    "spacing": { "0": "0px", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px" },
    "radius": { "none": "0px", "sm": "6px", "md": "8px", "lg": "12px", "xl": "16px", "pill": "999px" },
    "motion": { "fast": "120ms", "base": "180ms", "slow": "240ms", "ease": "cubic-bezier(0.2,0,0,1)" },
    "type": { "body": "IBM Plex Sans Arabic", "display": "Cairo", "mono": "IBM Plex Mono" }
  },
  "semantic": {
    "surface": { "page": "{primitive.color.ink}", "panel": "{primitive.color.surface}", "container": "{primitive.color.card}", "raised": "{primitive.color.raised}", "overlay": "{primitive.color.void}" },
    "content": { "primary": "{primitive.color.t1}", "secondary": "{primitive.color.t2}", "tertiary": "{primitive.color.t3}", "decorative": "{primitive.color.t4}" },
    "border": { "default": "{primitive.color.rim1}", "strong": "{primitive.color.rim2}", "emphasis": "{primitive.color.rim3}", "focus": "{primitive.color.gold3}" },
    "action": { "primary": "{primitive.color.gold}", "primaryHover": "{primitive.color.gold2}", "primaryActive": "{primitive.color.gold3}", "link": "{primitive.color.gold3}", "destructive": "{primitive.color.crimson}" },
    "status": { "success": "{primitive.color.emerald}", "danger": "{primitive.color.crimson}", "info": "{primitive.color.azure}", "warning": "{primitive.color.amber}" }
  },
  "component": {
    "control": { "minHeight": "44px", "focusRingWidth": "2px", "focusRingOffset": "2px" },
    "button": { "heightSm": "32px", "heightMd": "40px", "heightLg": "48px", "radius": "{primitive.radius.md}" },
    "input": { "height": "44px", "radius": "{primitive.radius.sm}" },
    "table": { "rowMinHeight": "48px", "cellX": "16px", "cellY": "12px" },
    "dialog": { "radius": "{primitive.radius.lg}", "maxWidth": "520px" },
    "drawer": { "maxWidth": "480px" }
  },
  "responsive": {
    "mobile": "<768px",
    "tablet": "768px-1279px",
    "desktop": ">=1280px",
    "wide": ">=1600px"
  },
  "accessibility": {
    "standard": "WCAG 2.2 AA",
    "textContrast": "4.5:1",
    "largeTextContrast": "3:1",
    "nonTextContrast": "3:1",
    "touchTarget": "44px",
    "keyboardFocus": "always-visible",
    "motionPreference": "prefers-reduced-motion"
  }
}
