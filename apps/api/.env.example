# Runtime environment: 'production' | 'staging' | 'development'
NODE_ENV=development

# Number of trusted reverse proxies in front of the API (for correct client IP
# in rate limiting). 0 = read the direct socket IP.
TRUSTED_PROXY_COUNT=0

# Database
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Better Auth (required — used to sign/verify sessions)
BETTER_AUTH_SECRET=
# Admin app: base URL used to reach the Better Auth /api/auth endpoints
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Admin app: base URL of the Hono API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Paymob Integration (payment webhook HMAC verification)
PAYMOB_HMAC_SECRET=

# Fawry Integration
FAWRY_BASE_URL=
FAWRY_MERCHANT_CODE=
FAWRY_SEC_KEY=

# WhatsApp 360dialog Integration
WHATSAPP_360DIALOG_API_KEY=

# Resend Integration
RESEND_API_KEY=
RESEND_FROM=

# Cloudflare R2 Integration
CF_ACCOUNT_ID=
CF_R2_BUCKET=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_PUBLIC_URL=

# ETA E-Invoicing (Egypt Tax Authority)
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=
ETA_ISSUER_EIN=
# Set to 'production' for live ETA API, leave empty for sandbox
ETA_ENV=
# Bosta courier (API calls + webhook verification)
BOSTA_API_KEY=
BOSTA_WEBHOOK_SECRET=

# Aramex courier (webhook verification)
ARAMEX_WEBHOOK_TOKEN=
