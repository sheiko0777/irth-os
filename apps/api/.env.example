# Database
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Better Auth (required — used to sign/verify sessions)
BETTER_AUTH_SECRET=
# Admin app: base URL used to reach the Better Auth /api/auth endpoints
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Admin app: base URL of the Hono API
NEXT_PUBLIC_API_URL=http://localhost:3001

# IRTH Intelligence (server-side only; set with wrangler secret in production)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fawry Integration
FAWRY_BASE_URL=
FAWRY_MERCHANT_CODE=
FAWRY_SEC_KEY=

# WhatsApp 360dialog Integration
WHATSAPP_360DIALOG_API_KEY=

# Resend Integration
RESEND_API_KEY=
RESEND_FROM=

# SMS Integration (Twilio-compatible REST API)
SMS_BASE_URL=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM=

# Request correlation (see middlewares/requestContext.ts). Leave unset —
# only opt in if every caller in front of this Worker is trusted, since a
# spoofable X-Request-Id is a log-injection vector.
TRUSTED_REQUEST_ID_HEADER=
# Structured logger's minimum emitted level (debug|info|warn|error).
# Defaults to 'info' in production, 'debug' otherwise.
LOG_LEVEL=

# Cloudflare R2 Integration
CF_ACCOUNT_ID=
CF_R2_BUCKET=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_PUBLIC_URL=

# ETA E-Invoicing (Egypt Tax Authority)
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=
ETA_ISSUER_EIN=
# Set to 'production' for live ETA API, leave empty for sandbox
ETA_ENV=
BOSTA_WEBHOOK_SECRET=
ARAMEX_WEBHOOK_TOKEN=
