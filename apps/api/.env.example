# Database
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Better Auth (required — used to sign/verify sessions)
BETTER_AUTH_SECRET=
# Admin app: base URL used to reach the Better Auth /api/auth endpoints
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Admin app: base URL of the Hono API
NEXT_PUBLIC_API_URL=http://localhost:3001

# IRTH Intelligence (server-side only; set with wrangler secret in production)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fawry Integration
FAWRY_BASE_URL=
FAWRY_MERCHANT_CODE=
FAWRY_SEC_KEY=

# WhatsApp 360dialog Integration
WHATSAPP_360DIALOG_API_KEY=

# Resend Integration
RESEND_API_KEY=
RESEND_FROM=

# Cloudflare R2 Integration
CF_ACCOUNT_ID=
CF_R2_BUCKET=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_PUBLIC_URL=

# ETA E-Invoicing (Egypt Tax Authority)
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=
ETA_ISSUER_EIN=
# Set to 'production' for live ETA API, leave empty for sandbox
ETA_ENV=
BOSTA_WEBHOOK_SECRET=
ARAMEX_WEBHOOK_TOKEN=
