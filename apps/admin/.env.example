# ─────────────────────────────────────────────────────────────
# irth-os admin (Next.js) — environment variables
# Copy to `.env.local` and fill in. NEXT_PUBLIC_* are exposed to
# the browser; everything else is server-only.
# ─────────────────────────────────────────────────────────────

# Database — required at runtime (admin runs tRPC routers that hit the DB via @irth/db)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Better Auth — must match the API's BETTER_AUTH_SECRET (shared session signing)
BETTER_AUTH_SECRET=

# Public URLs
# Base URL of the admin app itself (used for auth callbacks / session checks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Base URL of the Hono API
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase (client SDK — storage / realtime)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Platform admin gating
# Server-side check for platform-admin-only actions
PLATFORM_ADMIN_EMAIL=
# Client-side hint to show/hide platform-admin UI (not a security boundary)
NEXT_PUBLIC_PLATFORM_ADMIN_EMAIL=

# ETA E-Invoicing (Egypt Tax Authority) — admin has a server-side ETA path
# Set ETA_ENV to 'production' for live, leave empty for sandbox
ETA_ENV=
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=
ETA_ISSUER_EIN=
